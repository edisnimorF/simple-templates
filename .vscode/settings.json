{
	// Keep interactive C++ work from competing with 18 clangd worker threads.
	"clangd.arguments": [
		"--query-driver=D:/msys64/mingw64/bin/g++.exe",
		"--background-index",
		"--background-index-priority=low",
		"-j=4",
		"--pch-storage=memory",
		"--header-insertion=never",
		"--completion-style=detailed",
		"--all-scopes-completion",
		"--fallback-style=none"
	],
	// Let VS Code filter complete result lists without a round trip per letter.
	"clangd.serverCompletionRanking": false,
	"[cpp]": {
		// "editor.inlayHints.enabled": "off",
		"editor.quickSuggestionsDelay": 75,
		// 2-space indent for this folder (matches .clang-format / Google style).
		"editor.tabSize": 2,
		"editor.insertSpaces": true,
		"editor.formatOnSave": true
		// "editor.cursorSmoothCaretAnimation": "off"
	},
	"files.watcherExclude": {
		"**/*.exe": true
	}
}